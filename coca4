# Inicializa o mixer do Pygame
pygame.mixer.init()

# Verifica se o caminho do MP3 está correto
if not os.path.exists(MUSIC_FILE):
    print(f"Arquivo de música não encontrado: {MUSIC_FILE}")
else:
    try:
        pygame.mixer.music.load(MUSIC_FILE)
    except pygame.error as e:
        print(f"Erro ao carregar a música: {e}")

# Função para atualizar o letreiro de karaokê
def update_lyrics(current_time):
    global current_line
    if current_line < len(lyrics) and lyrics[current_line][0] <= current_time:
        canvas.delete('lyrics')
        canvas.create_text(window_width // 2, y_pos, text=lyrics[current_line][1], font=("Arial", 16), fill="white", tag='lyrics')
        current_line += 1

# Função para tocar a música e atualizar o letreiro
def play_music():
    pygame.mixer.music.play()  # Toca a música uma vez
    start_time = time.time()  # Marca o tempo inicial
    root.after(int(speed_scale.get()), track_lyrics, start_time)  # Inicia a atualização das letras

# Função para acompanhar a música e atualizar as letras
def track_lyrics(start_time):
    global y_pos
    current_time = time.time() - start_time
    update_lyrics(current_time)
    
    # Move o texto de baixo para cima
    y_pos -= 2  # Ajuste da velocidade de movimento (2 pixels por ciclo)
    
    # Se o texto sair da tela (acima), reposiciona na parte de baixo
    if y_pos < -30:
        y_pos = window_height
    
    # Continua atualizando o letreiro
    root.after(int(speed_scale.get()), track_lyrics, start_time)

# Função para pausar a música
def pause_music():
    pygame.mixer.music.pause()

# Função para retomar a música
def unpause_music():
    pygame.mixer.music.unpause()

# Função para parar a música
def stop_music():
    pygame.mixer.music.stop()

