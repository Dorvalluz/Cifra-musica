# Define o fundo da janela como preto
root.configure(bg="black")

# Cria um painel para o letreiro
panel_frame = tk.Frame(root, bg="black")
panel_frame.pack(fill="both", expand=True)

# Cria um canvas dentro do painel
canvas = tk.Canvas(panel_frame, bg="black")
