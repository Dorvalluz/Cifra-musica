# Variáveis de controle
current_line = 0
y_pos = canvas.winfo_height()  # Começa a partir da parte inferior da tela

# Variáveis de tamanho da janela
def update_window_size(event):
    global window_width, window_height, y_pos
    window_width = event.width
    window_height = event.height
    y_pos = window_height  # Atualiza a posição inicial para a parte inferior da janela

root.bind("<Configure>", update_window_size)

# Botões de controle de música
control_frame = tk.Frame(root, bg="lightgray", pady=10)
control_frame.pack(fill="x")

play_button = tk.Button(control_frame, text="PLAY", command=play_music)
